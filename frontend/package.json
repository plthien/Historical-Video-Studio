{
  "name": "historical-video-studio-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23",
    "npm": ">=10 <12"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "verify:toolchain": "node -e \"if(process.versions.node.split('.')[0]!=='22') process.exit(2)\"",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@remotion/player": "4.0.524",
    "remotion": "4.0.524",
    "ajv": "8.17.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@types/node": "22.18.10",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.9.3",
    "vite": "7.1.9",
    "@types/pngjs": "6.0.5"
  }
}
