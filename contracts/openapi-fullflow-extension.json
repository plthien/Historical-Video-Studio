    "/projects/{project_id}": {
      "get": {
        "operationId": "get__projects_project_id_",
        "tags": [
          "project"
        ],
        "summary": "Read project, revision and gate blockers",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Revision-aware data or completed mutation; review state remains explicit"
          },
          "202": {
            "description": "Durable queued job ID, state and revision"
          },
          "409": {
            "description": "Stale revision, illegal gate transition or operation conflict"
          },
          "422": {
            "description": "Schema, cross-reference, provider or historical evidence validation"
          },
          "424": {
            "description": "Missing/stale G1-G5 upstream dependency"
          }
        }
      }
    },
