{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://historical-video-studio.local/contracts/WordTimingMap.v1.schema.json",
  "title": "WordTimingMap.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "WordTimingMap.v1"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,63}$"
    },
    "provider_id": {
      "const": "elevenlabs_forced_alignment"
    },
    "audio_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "transcript_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sample_rate": {
      "type": "integer",
      "minimum": 8000
    },
    "words": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "word_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,63}$"
          },
          "section_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,63}$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "start_sample": {
            "type": "integer",
            "minimum": 0
          },
          "end_sample": {
            "type": "integer",
            "minimum": 1
          },
          "loss": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "word_id",
          "section_id",
          "text",
          "start_sample",
          "end_sample"
        ]
      },
      "minItems": 1
    },
    "anomalies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "word_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,63}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "description"
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "provider_id",
    "audio_sha256",
    "transcript_sha256",
    "sample_rate",
    "words",
    "anomalies"
  ]
}
