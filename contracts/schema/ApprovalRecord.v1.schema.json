{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://historical-video-studio.local/contracts/ApprovalRecord.v1.schema.json",
  "title": "ApprovalRecord.v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "ApprovalRecord.v1"
    },
    "approval_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,63}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,63}$"
    },
    "gate_id": {
      "type": "string",
      "enum": [
        "G1",
        "G2",
        "G3",
        "G4",
        "G5"
      ]
    },
    "decision": {
      "type": "string",
      "enum": [
        "APPROVED",
        "CHANGES_REQUESTED",
        "REJECTED"
      ]
    },
    "candidate_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dependency_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "approved_by": {
      "const": "local_operator"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "comment": {
      "type": "string"
    },
    "affected_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,63}$"
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "approval_id",
    "project_id",
    "gate_id",
    "decision",
    "candidate_sha256",
    "dependency_fingerprint",
    "expected_revision",
    "approved_by",
    "approved_at",
    "affected_ids"
  ],
  "additionalProperties": false
}
