{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://historical-video-studio.local/contracts/VoiceRequest.v1.schema.json",
  "title": "VoiceRequest.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "VoiceRequest.v1"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,63}$"
    },
    "story_revision_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provider_id": {
      "type": "string",
      "enum": [
        "kokoro_local",
        "elevenlabs_tts"
      ]
    },
    "language": {
      "const": "en"
    },
    "voice_id": {
      "type": "string",
      "minLength": 1
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "section_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,63}$"
          },
          "text_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "speed": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 2
          }
        },
        "required": [
          "section_id",
          "text_sha256",
          "text"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "story_revision_sha256",
    "provider_id",
    "language",
    "voice_id",
    "sections"
  ]
}
