                    "translate_x_px",
                    "translate_y_px",
                    "scale",
                    "rotation_deg",
                    "mask_progress",
                    "path_progress",
                    "highlight_progress"
                  ]
                },
                "cue_binding": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "word_id": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,63}$"
