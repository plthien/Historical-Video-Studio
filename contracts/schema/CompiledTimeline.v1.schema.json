      "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,63}$"
    },
    "fps": {
      "const": 30
    },
    "width": {
      "const": 1920
    },
    "height": {
      "const": 1080
    },
    "total_frames": {
      "type": "integer",
      "minimum": 1
    },
    "style_version": {
      "const": "HistoryEditorialPaper.v1"
    },
    "template_registry_version": {
