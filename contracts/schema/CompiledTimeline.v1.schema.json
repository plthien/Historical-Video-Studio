                        "none",
                        "source_photo_card",
                        "cutout_reviewed",
                        "ink_map",
                        "paper_document",
                        "parallax_foreground",
                        "parallax_background",
                        "headline_text"
                      ]
                    },
                    "source_preserving": {
                      "const": true
                    },
                    "evidence_badge": {
                      "type": "string",
                      "enum": [
                        "none",
                        "archival",
                        "AI_illustration",
                        "schematic",
                        "modern_reconstruction"
                      ]
                    }
                  },
                  "required": [
                    "kind",
                    "source_preserving",
                    "evidence_badge"
                  ]
                },
                "path_geometry_ref": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,63}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "text_layout": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "font_token": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        "font_size_px": {
                          "type": "integer",
                          "minimum": 20,
                          "maximum": 160
                        },
                        "line_height": {
                          "type": "number",
                          "minimum": 1,
                          "maximum": 2.5
                        },
                        "letter_spacing_px": {
                          "type": "number",
                          "minimum": -6,
                          "maximum": 10
                        },
                        "horizontal_align": {
                          "type": "string",
                          "enum": [
                            "left",
                            "center",
                            "right"
                          ]
                        },
                        "vertical_align": {
                          "type": "string",
                          "enum": [
                            "top",
                            "center",
                            "bottom"
                          ]
                        },
                        "max_lines": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 8
                        },
                        "overflow": {
                          "type": "string",
                          "enum": [
                            "block",
                            "approved_split"
                          ]
                        }
                      },
                      "required": [
                        "font_token",
                        "font_size_px",
                        "line_height",
                        "letter_spacing_px",
                        "horizontal_align",
                        "vertical_align",
                        "max_lines",
                        "overflow"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "template_slot_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,63}$"
                },
                "source_asset_slot_id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,63}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "word_spans": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "word_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,63}$"
                      },
                      "word_text": {
                        "type": "string",
                        "minLength": 1
                      },
                      "start": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "end": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "required": [
                      "word_id",
                      "word_text",
                      "start",
                      "end"
                    ]
                  }
                }
              },
              "required": [
                "layer_id",
                "layer_kind",
                "z_index",
                "rect_px",
                "anchor",
                "crop_normalized",
                "object_fit",
                "mask",
                "style",
                "map_binding",
                "parent_layer_id",
                "group_id",
                "transform_origin",
                "depth_order",
                "treatment",
                "path_geometry_ref",
                "text_layout",
                "template_slot_id",
                "source_asset_slot_id"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "event_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,63}$"
                },
                "layer_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,63}$"
                },
                "preset_id": {
                  "type": "string",
                  "enum": [
                    "pop-in",
                    "stagger-reveal",
                    "route-line-draw",
                    "title-mask-reveal",
                    "typewriter",
                    "number-count",
                    "kinetic-type",
                    "parallax-layers",
                    "mask-transition",
                    "camera-pan",
                    "camera-push",
                    "freeze-hold",
                    "whip-pan",
                    "cross-dissolve",
                    "hard-cut",
                    "text-highlight",
                    "map-region-wipe",
                    "photo-card-enter",
                    "editorial-connector-draw"
                  ]
                },
                "start_frame": {
                  "type": "integer",
                  "minimum": 0
                },
                "duration_frames": {
                  "type": "integer",
                  "minimum": 1
                },
                "cue_word_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "params": {
                  "type": "object",
                  "maxProperties": 12,
                  "additionalProperties": {
                    "oneOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 250
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      },
                      {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 25,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,63}$"
                        }
                      }
                    ]
                  }
                },
                "keyframes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "frame": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000000
                      },
                      "value": {
                        "type": "number",
                        "minimum": -10000,
                        "maximum": 10000
                      },
                      "easing": {
                        "type": "string",
                        "enum": [
                          "linear",
                          "ease_in",
                          "ease_out",
                          "ease_in_out",
                          "cubic_soft",
                          "spring_subtle"
                        ]
                      }
                    },
                    "required": [
                      "frame",
                      "value",
                      "easing"
                    ]
                  },
                  "minItems": 1
                },
                "animated_property": {
                  "type": "string",
