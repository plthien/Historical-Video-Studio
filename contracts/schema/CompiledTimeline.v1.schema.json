                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "w": {
                      "type": "number",
                      "minimum": 0.001,
                      "maximum": 1
                    },
                    "h": {
                      "type": "number",
                      "minimum": 0.001,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "w",
                    "h"
                  ]
                },
                "object_fit": {
                  "type": "string",
                  "enum": [
                    "cover",
                    "contain",
                    "fill",
                    "none"
                  ]
                },
                "mask": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "none",
                        "rectangle",
                        "ellipse",
                        "polygon_asset"
