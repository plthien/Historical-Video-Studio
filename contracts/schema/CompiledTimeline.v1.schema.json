                    {
                      "type": "null"
                    }
                  ]
                },
                "transform_origin": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
