              "focus_path": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "at_frame": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000
