                },
                "style": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "font_token": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "color_token": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "stroke_token": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "max_lines": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 8
                    }
                  },
                  "required": [
                    "font_token",
                    "color_token",
                    "stroke_token",
                    "max_lines"
                  ]
