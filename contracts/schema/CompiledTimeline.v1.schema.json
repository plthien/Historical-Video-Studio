                        {
                          "type": "null"
                        }
                      ]
                    },
                    "offset_frames": {
                      "type": "integer",
                      "minimum": -30,
                      "maximum": 30
                    }
                  },
                  "required": [
                    "word_id",
                    "offset_frames"
                  ]
                },
                "phases": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "phase_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,63}$"
                      },
                      "kind": {
                        "type": "string",
                        "enum": [
                          "enter",
                          "emphasize",
                          "track",
                          "hold",
                          "exit"
                        ]
                      },
                      "start_offset_frames": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000000
                      },
                      "duration_frames": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000000
                      },
                      "depends_on_phase_ids": {
                        "type": "array",
                        "minItems": 0,
                        "items": {
                          "type": "string",
                          "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,63}$"
                        }
                      }
                    },
                    "required": [
                      "phase_id",
                      "kind",
                      "start_offset_frames",
                      "duration_frames",
                      "depends_on_phase_ids"
                    ]
                  }
                },
                "motion_space": {
                  "type": "string",
                  "enum": [
                    "layer_local",
                    "group_local",
                    "map_world",
                    "screen"
                  ]
                },
                "affected_layer_ids": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,63}$"
                  }
                },
                "stagger": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "order": {
                          "type": "array",
                          "minItems": 2,
                          "items": {
                            "type": "string",
                            "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,63}$"
                          }
                        },
                        "offset_frames": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 100
                        }
                      },
                      "required": [
                        "order",
                        "offset_frames"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "depth_parallax": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "near_layer_ids": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "string",
                            "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,63}$"
                          }
                        },
                        "far_layer_ids": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "string",
                            "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,63}$"
                          }
                        },
                        "strength": {
                          "type": "number",
                          "minimum": 0.01,
                          "maximum": 1
                        }
                      },
                      "required": [
                        "near_layer_ids",
                        "far_layer_ids",
                        "strength"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "event_id",
                "layer_id",
                "preset_id",
                "start_frame",
                "duration_frames",
                "animated_property",
                "keyframes",
                "cue_binding",
                "phases",
                "motion_space",
                "affected_layer_ids",
                "stagger",
                "depth_parallax"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "camera": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "static",
                  "pan",
                  "push_in",
                  "pull_out",
                  "track_route",
                  "compare_locked"
                ]
              },
              "keyframes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "at_frame": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000
                    },
                    "x_px": {
                      "type": "number",
                      "minimum": -3840,
                      "maximum": 3840
                    },
                    "y_px": {
                      "type": "number",
                      "minimum": -2160,
                      "maximum": 2160
                    },
                    "scale": {
                      "type": "number",
                      "minimum": 0.5,
                      "maximum": 4
                    },
                    "rotation_deg": {
                      "type": "number",
                      "minimum": -15,
                      "maximum": 15
                    },
                    "opacity": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "easing": {
                      "type": "string",
                      "enum": [
                        "linear",
                        "ease_in",
                        "ease_out",
                        "ease_in_out",
                        "cubic_soft",
                        "spring_subtle"
                      ]
                    }
                  },
                  "required": [
                    "at_frame",
                    "x_px",
                    "y_px",
                    "scale",
                    "rotation_deg",
                    "opacity",
                    "easing"
                  ]
                },
                "minItems": 2
              },
              "focus_entity_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,63}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "clamp_to_content": {
                "type": "boolean"
