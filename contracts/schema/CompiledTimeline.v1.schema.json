    "motion_registry_version": {
      "type": "string",
      "minLength": 1
    },
    "story_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "audio_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "word_map_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "asset_snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
