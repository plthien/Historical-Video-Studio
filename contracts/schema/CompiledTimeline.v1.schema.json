                    "map",
                    "territory",
                    "route",
                    "portrait",
                    "archival_photo",
                    "document",
                    "headline",
                    "date",
                    "text",
                    "callout",
                    "camera",
                    "decorative_paper",
                    "annotation"
                  ]
                },
                "asset_id": {
