                      "minimum": -1920,
                      "maximum": 3840
                    },
                    "y": {
                      "type": "integer",
                      "minimum": -1080,
                      "maximum": 2160
                    },
                    "w": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 3840
                    },
                    "h": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 2160
                    }
