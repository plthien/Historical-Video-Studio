                },
                "parent_layer_id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,63}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "group_id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,63}$"
